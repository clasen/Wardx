{
  "host": "127.0.0.1",
  "port": 8787,
  "credentials": {
    "dev_project_key": {
      "label": "demo-client",
      "project": "demo",
      "allowedRoles": ["client", "game-server"],
      "trustedForDecisions": true,
      "enabled": true
    }
  },
  "sink": "memory",
  "ndjsonPath": "wardx-dev.ndjson",
  "maxRequestBytes": 2097152,
  "maxClockSkewMs": 300000,
  "maxFramesPerEnvelope": 256,
  "maxItemsPerEnvelope": 10000,
  "maxNameBytes": 256,
  "maxDimensionKeys": 8,
  "maxDimensionValueLength": 64,
  "maxAttributeKeys": 32,
  "maxAttributeValueLength": 1024,
  "persistenceFlushIntervalMs": 250,
  "diagnostics": { "sink": "stderr" },
  "aggregateRetentionMinutes": 60,
  "aggregateMaxSeriesPerMetric": 1000,
  "memorySinkMaxEnvelopes": 10000,
  "recentClientsMax": 100,
  "recentEventsMax": 1000,
  "recentLogsMax": 200,
  "sqlite": {
    "path": "wardx-dev.sqlite",
    "journalMode": "WAL",
    "synchronous": "NORMAL",
    "busyTimeoutMs": 5000,
    "walAutoCheckpointPages": 1000,
    "checkpointMode": "PASSIVE",
    "maxWriteBatchRows": 1000,
    "transactionTimeoutMs": 5000,
    "maxPendingBatches": 32,
    "maxPendingBytes": 67108864
  },
  "history": {
    "clockSkewAllowanceMs": 300000,
    "maxAcceptedPastAgeMs": 3600000,
    "aggregateHourlyRetentionHours": 720,
    "aggregateDailyRetentionDays": 365,
    "maxAppVersionsPerProjectRoleTier": 20,
    "maxQueryBuckets": 744,
    "maxQueryRows": 10000,
    "compactionIntervalMs": 60000
  },
  "control": {
    "journalCapacity": 1000,
    "maxConcurrentMcpReads": 8,
    "maxPendingMcpReads": 32
  },
  "mcpHttp": { "enabled": false },
  "capacity": { "maxConcurrentSyncHandlers": 256 },
  "experiments": { "ledgerMaxRows": 1000000 },
  "projects": {
    "demo": {
      "version": 1,
      "values": {
        "matchmaking.timeoutMs": 5000,
        "chat.enabled": true,
        "rewards.multiplier": 1.2,
        "message.delayMs": 1000
      },
      "keyRoles": {
        "matchmaking.timeoutMs": ["game-server"],
        "chat.enabled": ["client"],
        "rewards.multiplier": ["*"],
        "message.delayMs": ["client"]
      },
      "experiments": [
        {
          "id": "message-delay-v1",
          "enabled": true,
          "allocation": 1,
          "salt": "3ad8f9",
          "primaryMetric": "message.sent",
          "goalMetric": "message.sent",
          "assignmentUnitKind": "subject",
          "terminalRetentionMs": 604800000,
          "roles": ["client"],
          "variants": [
            {
              "key": "control",
              "weight": 50,
              "values": {
                "message.delayMs": 1000
              }
            },
            {
              "key": "fast",
              "weight": 50,
              "values": {
                "message.delayMs": 400
              }
            }
          ]
        }
      ],
      "catalog": {
        "description": "Demo chat product. A player client and a match service share this project.",
        "roles": {
          "client": {
            "description": "Player-facing client. Chat delay, purchases, messages sent."
          },
          "game-server": {
            "description": "Match service. Search timeout and throughput."
          }
        },
        "signals": {
          "matchmaking.timeoutMs": "Milliseconds before a matchmaking search expires",
          "chat.enabled": "Whether outbound chat is allowed",
          "rewards.multiplier": "Multiplier applied to reward grants",
          "message.delayMs": "Milliseconds to wait before sending a chat message",
          "message.sent": "Chat messages that left the client after the delay",
          "purchase": "Completed in-app purchase"
        },
        "inspectEvents": ["purchase"],
        "experiments": {
          "message-delay-v1": {
            "hypothesis": "Shorter delay increases messages sent"
          }
        }
      }
    }
  }
}
