{
  "name": "wardx-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "wardx-monorepo",
      "workspaces": [
        "packages/*",
        "examples/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "examples/basic-node": {
      "name": "@wardx/example-basic-node",
      "version": "0.1.0",
      "dependencies": {
        "wardx": "*"
      }
    },
    "node_modules/@wardx/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@wardx/example-basic-node": {
      "resolved": "examples/basic-node",
      "link": true
    },
    "node_modules/@wardx/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@wardx/stress": {
      "resolved": "packages/stress",
      "link": true
    },
    "node_modules/wardx": {
      "resolved": "packages/node",
      "link": true
    },
    "packages/core": {
      "name": "@wardx/core",
      "version": "0.1.0"
    },
    "packages/node": {
      "name": "wardx",
      "version": "0.1.0",
      "dependencies": {
        "@wardx/core": "*"
      }
    },
    "packages/server": {
      "name": "@wardx/server",
      "version": "0.1.0",
      "bin": {
        "wardx-server": "src/cli.js"
      }
    },
    "packages/stress": {
      "name": "@wardx/stress",
      "version": "0.1.0",
      "dependencies": {
        "@wardx/core": "*",
        "@wardx/server": "*",
        "wardx": "*"
      }
    }
  }
}
